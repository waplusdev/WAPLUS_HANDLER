# ── Identity ─────────────────────────────
BOT_NAME=WaPlus
OWNER_NAME=Musteqeem
# Your number with country code, no + (comma for many owners)
OWNER_NUMBER=2348000000000
PREFIX=.

# ── Pairing ──────────────────────────────
# The WhatsApp number the bot will run on. Leave empty to type it in the terminal or the web panel.
PAIRING_NUMBER=
# 8 letters/numbers custom code. Empty = random code.
PAIRING_CODE=XADONITE
SESSION_DIR=session

# ── Behaviour ────────────────────────────
MODE=public
AUTO_READ=false
COOLDOWN_MS=2500

# ── Premium badges (toggle live with .premium) ──
AI_BADGE=true
VERIFIED_BADGE=true
META_LABEL=false
CHANNEL_FORWARD=true
# Your WhatsApp channel id, e.g. 120363000000000000@newsletter
CHANNEL_JID=
CHANNEL_NAME=WaPlus Updates
WEBSITE_URL=https://github.com/musteqeem/baileys

# ── AI (.ai) — add ONE key ───────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto

# ── Web panel ────────────────────────────
PORT=3000
# Optional: protects the pair endpoint
PANEL_KEY=
